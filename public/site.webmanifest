{
  "name": "Flomo Extension",
  "short_name": "Flomo Extension",
  "description": "在 Chrome 浏览器当前网页中整理本地草稿，再通过已登录的 flomo 网页保存到自己的账户。",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f4ed",
  "theme_color": "#f5f4ed",
  "lang": "zh-CN",
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "128x128",
      "type": "image/png"
    }
  ]
}
